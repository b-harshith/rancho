# ─────────────────────────────────────────────────────────────
# K12 Schools Data Extractor — Environment Configuration
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Browser concurrency (default 4 for 8GB RAM)
MAX_BROWSER_CONCURRENCY=4

# Memory flush cycle — close & relaunch browser every N schools
BROWSER_FLUSH_INTERVAL=50

# Playwright page-load timeout in seconds
PAGE_TIMEOUT_SECONDS=30

# OCR — path to Tesseract binary (brew install tesseract)
TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
